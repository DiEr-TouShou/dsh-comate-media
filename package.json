{
  "name": "dsh-comate-media",
  "displayName": "DSH Comate Media",
  "description": "Expose WPS Comate image and video generation to DeepSeek Harness as agent tools. Reuses the credential store of dsh-connect-comate, declared as a peer dependency. 把 WPS Comate 的图片与视频生成能力以工具形式暴露给 DeepSeek Harness，复用 dsh-connect-comate 的凭据存储（peer 依赖）。",
  "version": "0.1.1-rc.1",
  "license": "MIT",
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "wps",
    "comate",
    "image-generation",
    "video-generation"
  ],
  "type": "module",
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsdown",
    "prepack": "npm run build",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "check": "pnpm run typecheck && pnpm run test && pnpm run build",
    "verify:live": "node scripts/verify-live.mjs",
    "verify:release-tag": "node scripts/verify-release-tag.mjs"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "3.18.4"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": ">=4.0.1-rc.1 <5.0.0 || >=4.0.2 <5.0.0",
    "@deepseek-ai/dsh-attachment": ">=0.1.5-rc.1 <0.1.6-rc.1 || >=0.1.6-rc.1 <0.1.7-rc.1 || >=0.1.7-rc.1 <0.2.0-0",
    "@deepseek-ai/dsh-llm": ">=0.1.5-rc.1 <0.1.6-rc.1 || >=0.1.6-rc.1 <0.1.7-rc.1 || >=0.1.7-rc.1 <0.2.0-0",
    "@deepseek-ai/dsh-tools": ">=0.1.5-rc.1 <0.1.6-rc.1 || >=0.1.6-rc.1 <0.1.7-rc.1 || >=0.1.7-rc.1 <0.2.0-0",
    "@deepseek-ai/schemastery": ">=3.18.3 <4.0.0",
    "dsh-connect-comate": ">=0.5.1 <0.6.0"
  },
  "peerDependenciesMeta": {
    "dsh-connect-comate": {
      "optional": false
    },
    "@deepseek-ai/dsh-attachment": {
      "optional": true
    },
    "@deepseek-ai/dsh-tools": {
      "optional": false
    }
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.0.4",
    "@deepseek-ai/dsh-attachment": "0.1.7-rc.1",
    "@deepseek-ai/dsh-llm": "0.1.7-rc.1",
    "@deepseek-ai/dsh-tools": "0.1.7-rc.1",
    "@deepseek-ai/schemastery": "3.18.4",
    "@types/node": "^22.20.0",
    "dsh-connect-comate": "github:DiEr-TouShou/dsh-connect-comate#v0.5.1",
    "tsdown": "^0.22.2",
    "typescript": "^5.9.3",
    "vitest": "^4.1.8"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/DiEr-TouShou/dsh-comate-media.git"
  }
}
